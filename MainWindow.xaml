<Window x:Class="FornixxCRM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Fornixx CRM Pro"
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <!-- Nav button style -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active nav button style -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#20FF9800" />
        </Style>

        <!-- Company ComboBox item style: dark text on white popup background -->
        <Style x:Key="CompanyComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A2332" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFF3E0" />
                    <Setter Property="Foreground" Value="#FF6B00" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE0B2" />
                    <Setter Property="Foreground" Value="#E65100" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar (appears on RIGHT in RTL, LEFT in LTR) -->
            <ColumnDefinition Width="240" />
            <!-- Content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1A2332">
            <DockPanel>
                <!-- Logo area -->
                <Border DockPanel.Dock="Top" Background="#0F1924" Padding="16,20,16,16">
                    <StackPanel>
                        <TextBlock Text="Fornixx CRM Pro"
                                   FontSize="18" FontWeight="Bold" Foreground="#FF9800"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource App_Subtitle}"
                                   FontSize="10" Foreground="#888888"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Company selector — dark sidebar needs a custom popup style -->
                <Border DockPanel.Dock="Top" Background="#152030" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav_ActiveCompany}"
                                   FontSize="9" Foreground="#777777" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding SelectedCompany}"
                                  DisplayMemberPath="Name"
                                  Foreground="White"
                                  BorderBrush="#333333"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemContainerStyle="{StaticResource CompanyComboItemStyle}">
                            <ComboBox.Resources>
                                <!-- Override theme colors inside the dropdown popup -->
                                <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="MaterialDesignBody" Color="#1A2332" />
                                <SolidColorBrush x:Key="MaterialDesignToolBackground" Color="#FFFFFF" />
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Separator DockPanel.Dock="Top" Background="#2A3A4A" Margin="16,8" />

                <!-- Nav section title -->
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Nav_MainMenu}"
                           FontSize="9" Foreground="#555555" Margin="16,4,16,4" />

                <!-- Navigation buttons -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Dashboard}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToCustomersCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Customers}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToProductsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Products}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="Package" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToQuotationsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Quotations}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToInvoicesCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Invoices}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="Receipt" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Separator Background="#2A3A4A" Margin="16,8" />
                        <TextBlock Text="{DynamicResource Nav_AnalysisMgmt}"
                                   FontSize="9" Foreground="#555555" Margin="16,0,16,4" />

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToReportsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Reports}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToCompaniesCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Companies}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButtonStyle}"
                                Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{DynamicResource Nav_Settings}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom version info -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" Background="#0F1924">
                    <TextBlock Text="{DynamicResource App_Version}"
                               FontSize="9" Foreground="#444444"
                               HorizontalAlignment="Center" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="White"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Padding="20,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ActiveCompanyName}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#FF6B00"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource App_Title}"
                               FontSize="12" Foreground="#888888"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Main content via DataTemplate navigation -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}" />
        </Grid>
    </Grid>
</Window>
