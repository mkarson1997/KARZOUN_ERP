<Window x:Class="KarzounERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Title="KARZOUN ERP"
        Height="750" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource BrandBackground}"
        Icon="Resources/Brand/AppIcon.ico"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <!-- Nav button style -->
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource BrandNavigationText}" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="8,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandNavigationHover}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active nav button style -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource BrandNavigationSelected}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <!-- Company ComboBox item style: dark text on white popup background -->
        <Style x:Key="CompanyComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrandTextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrandSurface}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSecondaryMutedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSecondaryHighlightBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource BrandTextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar (appears on RIGHT in RTL, LEFT in LTR) -->
            <ColumnDefinition Width="240" />
            <!-- Content area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BrandNavigationBackground}">
            <DockPanel>
                <!-- Logo area -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrandNavigationBackground}"
                        BorderBrush="{DynamicResource BrandNavigationHover}" BorderThickness="0,0,0,1"
                        Padding="16,16,16,14">
                    <!-- The supplied K mark and Latin lockup must never mirror in Arabic RTL. -->
                    <Grid FlowDirection="LeftToRight" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="10"
                                Background="#F7F9FC" Padding="6" Margin="0,0,12,0">
                            <Image Source="Resources/Brand/Karzoun_Mark.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="KARZOUN" FontFamily="{DynamicResource BrandHeadlineFontFamily}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="ERP" FontFamily="{DynamicResource BrandHeadlineFontFamily}"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccent}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Company selector — dark sidebar needs a custom popup style -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BrandNavigationHover}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Nav_ActiveCompany}"
                                   FontSize="9" Foreground="{DynamicResource BrandNavigationTextMuted}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Companies}"
                                  SelectedItem="{Binding SelectedCompany}"
                                  DisplayMemberPath="Name"
                                  Foreground="White"
                                  BorderBrush="{DynamicResource BrandNavigationTextMuted}"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  ItemContainerStyle="{StaticResource CompanyComboItemStyle}">
                            <ComboBox.Resources>
                                <!-- Override theme colors inside the dropdown popup -->
                                <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FFFFFF" />
                                <SolidColorBrush x:Key="MaterialDesignBody" Color="#0B1324" />
                                <SolidColorBrush x:Key="MaterialDesignToolBackground" Color="#FFFFFF" />
                            </ComboBox.Resources>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Separator DockPanel.Dock="Top" Background="{DynamicResource BrandNavigationHover}" Margin="16,8" />

                <!-- Nav section title -->
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Nav_MainMenu}"
                           FontSize="9" Foreground="{DynamicResource BrandNavigationTextMuted}" Margin="16,4,16,4" />

                <!-- Navigation buttons -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="DashboardNavButton" Style="{StaticResource NavButtonActiveStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Dashboard}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CustomersNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToCustomersCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Customers}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ProductsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToProductsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="Package" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Products}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="QuotationsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToQuotationsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="FileDocument" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Quotations}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="InvoicesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToInvoicesCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="Receipt" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Invoices}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Separator Background="{DynamicResource BrandNavigationHover}" Margin="16,8" />
                        <TextBlock Text="{DynamicResource Nav_AnalysisMgmt}"
                                   FontSize="9" Foreground="{DynamicResource BrandNavigationTextMuted}" Margin="16,0,16,4" />

                        <Button x:Name="ReportsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToReportsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Reports}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="CompaniesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToCompaniesCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Companies}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="AppearanceNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToAppearanceCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="Palette" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Sett_AppearanceSection}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Settings}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="LogsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigationButton_Click"
                                Command="{Binding NavigateToLogsCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppContentAlignment}" FlowDirection="{DynamicResource AppFlowDirection}">
                                <materialDesign:PackIcon Kind="FileDocumentAlertOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                                <TextBlock Text="{DynamicResource Nav_Logs}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom version info -->
                <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource BrandNavigationBackground}"
                        BorderBrush="{DynamicResource BrandNavigationHover}" BorderThickness="0,1,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource App_VersionLine}"
                                   FontSize="10" Foreground="{DynamicResource BrandNavigationTextMuted}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource App_DeveloperCredit}"
                                   FontSize="9" Foreground="{DynamicResource BrandNavigationTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{DynamicResource BrandSurface}"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Padding="20,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ActiveCompanyName}"
                               FontSize="13" FontWeight="SemiBold"
                                Foreground="{DynamicResource AppPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource App_Title}"
                                FontSize="12" Foreground="{DynamicResource BrandTextSecondary}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Main content via DataTemplate navigation -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}" />

            <!-- Toast Notification Card Overlay -->
            <Grid Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0" Panel.ZIndex="9999"
                  Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibility}}">
                <materialDesign:Card Background="{Binding NotificationColor}" Foreground="White" UniformCornerRadius="6"
                                     materialDesign:ElevationAssist.Elevation="Dp6" Padding="16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding NotificationIcon}" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NotificationMessage}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxWidth="500"/>
                        <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="4" Margin="16,0,0,0" MinWidth="24" Height="24"
                                Command="{Binding DismissNotificationCommand}">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</Window>
