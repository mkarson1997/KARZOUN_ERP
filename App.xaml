<Application x:Class="FornixxCRM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FornixxCRM.ViewModels"
             xmlns:views_dashboard="clr-namespace:FornixxCRM.Views.Dashboard"
             xmlns:views_companies="clr-namespace:FornixxCRM.Views.Companies"
             xmlns:views_customers="clr-namespace:FornixxCRM.Views.Customers"
             xmlns:views_products="clr-namespace:FornixxCRM.Views.Products"
             xmlns:views_documents="clr-namespace:FornixxCRM.Views.Documents"
             xmlns:views_settings="clr-namespace:FornixxCRM.Views.Settings"
             xmlns:views_reports="clr-namespace:FornixxCRM.Views.Reports"
             xmlns:conv="clr-namespace:FornixxCRM.Helpers.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <!-- MaterialDesign theme ResourceDictionaries are loaded programmatically in App.xaml.cs
                 OnStartup to avoid BundledTheme relative-URI resolution failures at XAML parse time -->

            <!-- Converters -->
            <conv:EnumToArabicConverter x:Key="EnumToArabic" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:DecimalFormatConverter x:Key="DecimalFormat" />
            <conv:StatusToColorConverter x:Key="StatusToColor" />
            <conv:UtcToLocalTimeConverter x:Key="UtcToLocalTime" />

            <!-- Global FlowDirection -->
            <Style TargetType="{x:Type FrameworkElement}">
                <Setter Property="FlowDirection" Value="{DynamicResource AppFlowDirection}" />
            </Style>

            <!-- DataTemplates: ViewModel → View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views_dashboard:DashboardPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CompanyViewModel}">
                <views_companies:CompanyListPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
                <views_customers:CustomerListPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CustomerDetailViewModel}">
                <views_customers:CustomerDetailPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductViewModel}">
                <views_products:ProductListPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                <views_documents:DocumentListPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentFormViewModel}">
                <views_documents:DocumentFormPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views_settings:SettingsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views_reports:ReportsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
