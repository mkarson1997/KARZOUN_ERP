<UserControl x:Class="FornixxCRM.Views.Companies.CompanyListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="OfficeBuilding" Width="28" Height="28" Foreground="#FF6B00" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Comp_Title}" FontSize="24" FontWeight="Bold" Foreground="#1A2332" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Comp_New}"
                    Command="{Binding AddCompanyCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FF6B00" BorderBrush="#FF6B00"
                    Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Companies DataGrid -->
        <materialDesign:Card Grid.Row="2" Padding="0" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding Companies}"
                      SelectedItem="{Binding SelectedCompany}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="12 8"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Comp_ColName}" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Comp_ColCommercial}" Binding="{Binding CommercialName}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource Comp_ColPhone}" Binding="{Binding Phone}" Width="130" />
                    <DataGridTextColumn Header="{DynamicResource Comp_ColCurrency}" Binding="{Binding Currency}" Width="80" />
                    <DataGridTextColumn Header="{DynamicResource Comp_ColTax}" Binding="{Binding TaxRate, StringFormat=N1}" Width="80" />
                    <DataGridTemplateColumn Header="{DynamicResource Comp_ColActions}" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Btn_Activate}"
                                            Command="{Binding DataContext.SetActiveCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#00897B" Padding="8,4" />
                                    <Button Content="{DynamicResource Btn_Edit}"
                                            Command="{Binding DataContext.EditCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#1565C0" Padding="8,4" />
                                    <Button Content="{DynamicResource Btn_Delete}"
                                            Command="{Binding DataContext.DeleteCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#F44336" Padding="8,4" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
