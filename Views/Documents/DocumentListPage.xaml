<UserControl x:Class="FornixxCRM.Views.Documents.DocumentListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Receipt" Width="28" Height="28" Foreground="#FF6B00" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold" Foreground="#1A2332"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
            <Button Content="{DynamicResource DocList_New}"
                    Command="{Binding CreateDocumentCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#FF6B00" BorderBrush="#FF6B00"
                    Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Filters -->
        <materialDesign:Card Grid.Row="1" Padding="12,8" Margin="0,0,0,12" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AllStatuses}"
                          SelectedItem="{Binding FilterStatus}"
                          materialDesign:HintAssist.Hint="{DynamicResource DocList_FilterStatus}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text><Binding Converter="{StaticResource EnumToArabic}" /></TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding FilterFromDate, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="{DynamicResource DocList_FilterFromDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <DatePicker Grid.Column="4"
                            SelectedDate="{Binding FilterToDate, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="{DynamicResource DocList_FilterToDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <Button Grid.Column="6" Content="{DynamicResource Btn_Apply}"
                        Command="{Binding FilterChangedCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF6B00" BorderBrush="#FF6B00" />

                <Button Grid.Column="8" Content="{DynamicResource Btn_Reset}"
                        Command="{Binding ResetFiltersCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </Grid>
        </materialDesign:Card>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <materialDesign:Card Grid.Row="3" Padding="0" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding Documents}"
                      SelectedItem="{Binding SelectedDocument}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="10 8"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource DocList_ColNumber}" Binding="{Binding DocumentNumber}" Width="130" />
                    <DataGridTemplateColumn Header="{DynamicResource DocList_ColType}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type, Converter={StaticResource EnumToArabic}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource DocList_ColCustomer}" Binding="{Binding Customer.FullName}" Width="*" />
                    <DataGridTextColumn Header="{DynamicResource DocList_ColDate}" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100" />
                    <DataGridTemplateColumn Header="{DynamicResource DocList_ColStatus}" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToColor}}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumToArabic}}"
                                               Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource DocList_ColTotal}" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120" />
                    <DataGridTemplateColumn Header="{DynamicResource DocList_ColActions}" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Btn_Edit}"
                                            Command="{Binding DataContext.EditDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#1565C0" Padding="4,4" />
                                    <Button Content="{DynamicResource Btn_Pdf}"
                                            Command="{Binding DataContext.ExportPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#00897B" Padding="4,4" />
                                    <Button Content="{DynamicResource Btn_Duplicate}"
                                            Command="{Binding DataContext.DuplicateDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#FF9800" Padding="4,4" />
                                    <Button Content="{DynamicResource Btn_Convert}"
                                            Command="{Binding DataContext.ConvertToInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#7B1FA2" Padding="4,4"
                                            Visibility="{Binding IsQuotation, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{DynamicResource Btn_Delete}"
                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#F44336" Padding="4,4" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#888">
            <Run Text="{DynamicResource DocList_Total}" />
            <Run Text="{Binding TotalCount}" FontWeight="Bold" />
            <Run Text="{DynamicResource DocList_TotalUnit}" />
        </TextBlock>
    </Grid>
</UserControl>
