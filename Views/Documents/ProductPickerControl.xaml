<UserControl x:Class="KarzounERP.Views.Documents.ProductPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="420">
    <StackPanel>
        <ComboBox x:Name="ProductComboBox"
                  IsEditable="True"
                  Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding FilteredPickerItems}"
                  SelectedItem="{Binding SelectedPickerItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectionChanged="ProductComboBox_SelectionChanged"
                  MinWidth="420"
                  MaxDropDownHeight="360"
                  HorizontalAlignment="Stretch"
                  IsTextSearchEnabled="False"
                  StaysOpenOnEdit="True"
                  materialDesign:HintAssist.Hint="{DynamicResource DocForm_ProductSearchHint}"
                  materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                  BorderThickness="0"
                  Background="Transparent"
                  Padding="2,4">
            <ComboBox.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinHeight" Value="38" />
                </Style>
            </ComboBox.Resources>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinWidth="460">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Plus"
                                                 Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Margin="{DynamicResource AppMargin_8_0}"
                                                 Foreground="{DynamicResource AppPrimaryBrush}">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomOption}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayLine}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding DisplayLine}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrandTextPrimary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomOption}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProductNameInvalid}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                            <Setter Property="ToolTip" Value="{DynamicResource Msg_ValidationItemName}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>

        <Button Content="{DynamicResource DocForm_AddCustomProduct}"
                Command="{Binding UseCustomProductCommand}"
                IsEnabled="{Binding CanUseCustomProduct}"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                HorizontalAlignment="{DynamicResource AppContentAlignment}"
                Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
