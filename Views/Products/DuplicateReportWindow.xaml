<Window x:Class="KarzounERP.Views.Products.DuplicateReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource DuplicateReport_Title}" Height="480" Width="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="/Resources/Brand/AppIcon.ico"
        Background="{DynamicResource BrandBackground}"
        FontFamily="{DynamicResource AppFontFamily}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource DuplicateReport_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandTextPrimary}" />
            <TextBlock Text="{DynamicResource DuplicateReport_Subtitle}" FontSize="11" Foreground="#777" Margin="0,4,0,0" />
        </StackPanel>

        <materialDesign:Card Grid.Row="2" Padding="0" UniformCornerRadius="6">
            <DataGrid x:Name="DuplicateGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="8 6" BorderThickness="0"
                      MouseDoubleClick="DuplicateGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Dup_ProductA}" Binding="{Binding ProductAName}" Width="1.4*" />
                    <DataGridTextColumn Header="{DynamicResource Dup_ProductB}" Binding="{Binding ProductBName}" Width="1.4*" />
                    <DataGridTextColumn Header="{DynamicResource Dup_NameSimilarity}" Binding="{Binding NameSimilarity}" Width="110" />
                    <DataGridTextColumn Header="{DynamicResource Dup_IdentitySimilarity}" Binding="{Binding IdentitySimilarity}" Width="120" />
                    <DataGridTextColumn Header="{DynamicResource Dup_Reason}" Binding="{Binding Reason}" Width="1.3*" />
                    <DataGridTextColumn Header="{DynamicResource Dup_SuggestedAction}" Binding="{Binding SuggestedAction}" Width="1.3*" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Btn_Edit}" Click="EditButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}" Margin="0,0,8,0" Width="100" />
            <Button Content="{DynamicResource Btn_Cancel}" Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" />
        </StackPanel>
    </Grid>
</Window>
