<UserControl x:Class="KarzounERP.Views.Products.ProductListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource AppFlowDirection}"
             d:DesignHeight="600" d:DesignWidth="950">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Package" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Prod_Title}" FontSize="24" FontWeight="Bold" FontFamily="{DynamicResource AppHeadlineFontFamily}" Foreground="{DynamicResource BrandTextPrimary}"
                       Margin="{DynamicResource AppMargin_8_0}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Prod_New}"
                    Command="{Binding AddProductCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}"
                    Margin="{DynamicResource AppMargin_20_0}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Prod_ImportExcel}"
                    Command="{Binding ImportProductsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource AppPrimaryBrush}" BorderBrush="{DynamicResource AppButtonBrush}"
                    Margin="{DynamicResource AppMargin_10_0}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Prod_ExportExcel}"
                    Command="{Binding ExportProductsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource AppPrimaryBrush}" BorderBrush="{DynamicResource AppButtonBrush}"
                    Margin="{DynamicResource AppMargin_10_0}" VerticalAlignment="Center" />
            <Button Content="{DynamicResource Prod_CheckDuplicates}"
                    Command="{Binding CheckDuplicatesCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{DynamicResource AppPrimaryBrush}" BorderBrush="{DynamicResource AppButtonBrush}"
                    Margin="{DynamicResource AppMargin_10_0}" VerticalAlignment="Center" />
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Padding="12,8" Margin="0,0,0,12" UniformCornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="{DynamicResource Prod_SearchHint}"
                          Style="{StaticResource MaterialDesignOutlinedTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="2" Content="{DynamicResource Btn_Search}" Command="{Binding SearchCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}" />
            </Grid>
        </materialDesign:Card>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" Margin="0,0,0,4"
                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <materialDesign:Card Grid.Row="3" Padding="0" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding Products}"
                       AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       materialDesign:DataGridAssist.CellPadding="10 8"
                       BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDuplicateCandidate}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrandWarningMuted}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BrandWarning}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsThreeState="True"
                                          IsChecked="{Binding DataContext.AreAllProductsSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Command="{Binding DataContext.SelectionChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Dup_ColumnMark}" Width="90" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrandWarningMuted}" CornerRadius="4" Padding="6,2"
                                        Visibility="{Binding IsDuplicateCandidate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource Dup_PotentialDuplicate}" Foreground="{DynamicResource BrandWarning}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Image" Width="70" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource BrandSurfaceSecondary}" BorderBrush="{DynamicResource BrandBorder}" BorderThickness="1">
                                    <Image Source="{Binding ImagePath}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Prod_ColName}" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                    <DataGridTemplateColumn Header="{DynamicResource Prod_ColType}" Width="140" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type, Converter={StaticResource EnumToArabic}}"
                                           TextAlignment="{DynamicResource AppDataGridTextAlignment}"
                                           HorizontalAlignment="{DynamicResource AppContentAlignment}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Prod_ColWeight}" Width="120" MinWidth="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Weight, StringFormat=N2}" Visibility="{Binding Weight, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text=" " Visibility="{Binding Weight, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding WeightUnit}" Visibility="{Binding Weight, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="- " Visibility="{Binding Weight, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Prod_ColPrice}" Binding="{Binding UnitPrice, Converter={StaticResource MoneyFormat}}" Width="140" MinWidth="120" />
                    <DataGridTextColumn Header="{DynamicResource Prod_ColDefaultQty}" Binding="{Binding DefaultQuantity}" Width="120" MinWidth="100" />
                    <DataGridTemplateColumn Header="{DynamicResource Prod_ColStatus}" Width="100" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{Binding IsActive, Converter={StaticResource StatusToColor}}"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Prod_Inactive}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Prod_Active}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Prod_ColActions}" Width="170" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{DynamicResource Btn_Edit}"
                                            Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource BrandInfo}" Padding="6,4" />
                                    <Button Content="{DynamicResource Btn_Delete}"
                                            Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource BrandDanger}" Padding="6,4" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Foreground="#888" VerticalAlignment="Center">
                <Run Text="{DynamicResource Prod_Total}" />
                <Run Text="{Binding TotalCount}" FontWeight="Bold" />
                <Run Text="{DynamicResource Prod_TotalUnit}" />
                <Run Text=" | " />
                <Run Text="{DynamicResource Bulk_Selected}" />
                <Run Text="{Binding SelectedCount}" FontWeight="Bold" />
            </TextBlock>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding SelectedCount, Converter={StaticResource BoolToVisibility}}">
                <Button Content="{DynamicResource Btn_Clear}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Btn_Delete}" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource BrandDanger}" BorderBrush="{DynamicResource BrandDanger}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
