<Window x:Class="FornixxCRM.Views.Products.ProductFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource ProdForm_Name}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                <ComboBox ItemsSource="{Binding AllProductTypes}"
                          SelectedItem="{Binding Type}"
                          materialDesign:HintAssist.Hint="{DynamicResource ProdForm_Type}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource ProdForm_Description}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             materialDesign:HintAssist.Hint="{DynamicResource ProdForm_UnitPrice}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FlowDirection="LeftToRight" />
                    <TextBox Grid.Column="2"
                             Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             materialDesign:HintAssist.Hint="{DynamicResource ProdForm_Weight}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FlowDirection="LeftToRight" />
                </Grid>

                <TextBox Text="{Binding DefaultQuantity, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource ProdForm_DefaultQty}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FlowDirection="LeftToRight" Margin="0,0,0,12" />

                <CheckBox Content="{DynamicResource ProdForm_IsActive}" IsChecked="{Binding IsActive}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ValidationError}" Foreground="#F44336" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF6B00" BorderBrush="#FF6B00" Margin="0,0,8,0" Width="100" />
                <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
