<UserControl x:Class="KarzounERP.Views.Customers.CustomerDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource AppFlowDirection}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="{DynamicResource CustDetail_Back}" Command="{Binding GoBackCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource AppPrimaryBrush}" />
            <TextBlock Text="{DynamicResource CustDetail_Title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandTextPrimary}"
                       Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Customer Info Card -->
            <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="8" VerticalAlignment="Top">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AccountCircle" Width="48" Height="48"
                                            Foreground="{DynamicResource AppPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Customer.FullName}" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Customer.CompanyName}" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />

                    <Separator Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Phone" Width="16" Height="16" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Customer.Phone}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Email" Width="16" Height="16" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Customer.Email}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Customer.Country}" />
                    </Grid>

                    <Separator Margin="0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_FollowUpStage}" Foreground="#888" FontSize="11" />
                    <TextBlock Text="{Binding Customer.FollowUpStage, Converter={StaticResource EnumToArabic}}"
                               FontWeight="Bold" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_Importance}" Foreground="#888" FontSize="11" />
                    <TextBlock Text="{Binding Customer.Importance, Converter={StaticResource EnumToArabic}}"
                               Foreground="{Binding Customer.Importance, Converter={StaticResource StatusToColor}}"
                               FontWeight="Bold" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_Mindset}" Foreground="#888" FontSize="11" />
                    <TextBlock Text="{Binding Customer.CommercialMindset, Converter={StaticResource EnumToArabic}}"
                               FontWeight="Bold" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_LastFollowUp}" Foreground="#888" FontSize="11" />
                    <TextBlock Text="{Binding Customer.LastFollowUpDate, StringFormat=yyyy-MM-dd}"
                               FontWeight="Bold" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_NextFollowUp}" Foreground="#888" FontSize="11" />
                    <TextBlock Text="{Binding Customer.NextFollowUpDate, StringFormat=yyyy-MM-dd}"
                               FontWeight="Bold" Margin="0,2,0,8" />

                    <TextBlock Text="{DynamicResource CustDetail_Notes}" Foreground="#888" FontSize="11" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Customer.Notes}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Documents & Notes History -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>

                <!-- Documents History -->
                <materialDesign:Card Grid.Row="0" Padding="20" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource CustDetail_DocHistory}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Documents}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  materialDesign:DataGridAssist.CellPadding="10 6"
                                  BorderThickness="0" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource CustDetail_ColNumber}" Binding="{Binding DocumentNumber}" Width="*" />
                                <DataGridTemplateColumn Header="{DynamicResource CustDetail_ColType}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Type, Converter={StaticResource EnumToArabic}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource CustDetail_ColDate}" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTemplateColumn Header="{DynamicResource CustDetail_ColStatus}" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToArabic}}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource CustDetail_ColTotal}" Binding="{Binding GrandTotal, StringFormat=N2}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- Notes History -->
                <materialDesign:Card Grid.Row="2" Padding="20" UniformCornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="{DynamicResource CustDetail_NotesHistory}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                        <!-- Timeline / Notes List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding NotesHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="#EEE" Padding="0,8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" FontSize="13" Foreground="#222" />
                                                    <TextBlock Text="{Binding CreatedAt, Converter={StaticResource UtcToLocalTime}, StringFormat=yyyy-MM-dd HH:mm}" FontSize="10" Foreground="#888" Margin="0,4,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource MaterialDesignIconButton}"
                                                        Width="28" Height="28" Foreground="#888">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Add Note Box -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource CustDetail_AddNoteHint}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" MaxHeight="60" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <Button Grid.Column="2" Content="{DynamicResource CustDetail_AddNoteBtn}"
                                    Command="{Binding AddNoteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource BrandSuccess}" BorderBrush="{DynamicResource BrandSuccess}"
                                    VerticalAlignment="Bottom" Height="38" />
                        </Grid>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
