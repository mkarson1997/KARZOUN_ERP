<Window x:Class="KarzounERP.Views.Customers.ColumnSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Cust_ExportSelected}" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Resources/Brand/AppIcon.ico"
        Background="{DynamicResource BrandBackground}"
        FontFamily="{DynamicResource AppFontFamily}"
        FlowDirection="{DynamicResource AppFlowDirection}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Cust_SelectColumns}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="chkName" Content="{DynamicResource Cust_ColName}" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="chkCompany" Content="{DynamicResource Cust_ColCompany}" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="chkCountry" Content="{DynamicResource Cust_ColCountry}" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="chkPhone" Content="{DynamicResource Cust_ColPhone}" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="chkEmail" Content="Email" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="chkNotes" Content="Notes" IsChecked="True" Margin="0,4" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Select All" Click="SelectAll_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Clear" Click="Clear_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0" />
            <Button Content="Export" Click="Export_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}" />
        </StackPanel>
    </Grid>
</Window>
