<Window x:Class="KarzounERP.Views.Customers.CustomerFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Height="640" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Resources/Brand/AppIcon.ico"
        Background="{DynamicResource BrandBackground}"
        FontFamily="{DynamicResource AppFontFamily}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource CustForm_SectionBasic}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="13" Margin="0,0,0,12" />

                <TextBox x:Name="FullName" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_FullName}"
                         Margin="0,0,0,12">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFullNameInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Setter Property="ToolTip" Value="{DynamicResource Msg_ValidationCustomerName}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox IsEditable="True"
                          IsTextSearchEnabled="False"
                          ItemsSource="{Binding CompanyNameOptions}"
                          Text="{Binding CompanyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          materialDesign:HintAssist.Hint="{DynamicResource CustForm_CompanyName}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,8" />

                <Grid Margin="0,0,0,12"
                      Visibility="{Binding IsExternalCompanyName, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ExternalCompanyColor, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource CustForm_ExternalCompanyColor}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <Button Grid.Column="2"
                            Height="40"
                            Command="{Binding PickExternalCompanyColorCommand}"
                            ToolTip="{DynamicResource CompForm_PickColor}"
                            Background="{Binding ExternalCompanyColor, Converter={StaticResource HexToBrush}, ConverterParameter=#7B1FA2}"
                            BorderBrush="{DynamicResource BrandBorder}"
                            BorderThickness="1" />
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource CustForm_Phone}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <TextBox Grid.Column="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource CustForm_Email}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </Grid>

                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_Country}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />

                <Separator Margin="0,0,0,16" />
                <TextBlock Text="{DynamicResource CustForm_SectionFollowUp}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="13" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AllImportanceLevels}"
                              SelectedItem="{Binding Importance}"
                              materialDesign:HintAssist.Hint="{DynamicResource CustForm_Importance}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AllFollowUpStages}"
                              SelectedItem="{Binding FollowUpStage}"
                              materialDesign:HintAssist.Hint="{DynamicResource CustForm_FollowUpStage}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <ComboBox ItemsSource="{Binding AllCommercialMindsets}"
                          SelectedItem="{Binding CommercialMindset}"
                          materialDesign:HintAssist.Hint="{DynamicResource CustForm_CommercialMindset}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding LastFollowUpDate}"
                                materialDesign:HintAssist.Hint="{DynamicResource CustForm_LastFollowUpDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                    <DatePicker Grid.Column="2" SelectedDate="{Binding NextFollowUpDate}"
                                materialDesign:HintAssist.Hint="{DynamicResource CustForm_NextFollowUpDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                </Grid>

                <TextBox Text="{Binding CurrentObjection, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_CurrentObjection}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_Notes}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource BrandDanger}"
                           Margin="0,4,0,0" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BrandBorder}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{DynamicResource AppHorizontalAlignment}">
                <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}" Margin="{DynamicResource AppIconMargin}" Width="100" />
                <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
