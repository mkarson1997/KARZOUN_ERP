<Window x:Class="FornixxCRM.Views.Customers.CustomerFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}"
        Height="640" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource CustForm_SectionBasic}" FontWeight="Bold" Foreground="#FF6B00" FontSize="13" Margin="0,0,0,12" />

                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_FullName}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_CompanyName}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource CustForm_Phone}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <TextBox Grid.Column="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource CustForm_Email}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </Grid>

                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_Country}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />

                <Separator Margin="0,0,0,16" />
                <TextBlock Text="{DynamicResource CustForm_SectionFollowUp}" FontWeight="Bold" Foreground="#FF6B00" FontSize="13" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AllImportanceLevels}"
                              SelectedItem="{Binding Importance}"
                              materialDesign:HintAssist.Hint="{DynamicResource CustForm_Importance}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding AllFollowUpStages}"
                              SelectedItem="{Binding FollowUpStage}"
                              materialDesign:HintAssist.Hint="{DynamicResource CustForm_FollowUpStage}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <ComboBox ItemsSource="{Binding AllCommercialMindsets}"
                          SelectedItem="{Binding CommercialMindset}"
                          materialDesign:HintAssist.Hint="{DynamicResource CustForm_CommercialMindset}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,12">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToArabic}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" SelectedDate="{Binding LastFollowUpDate}"
                                materialDesign:HintAssist.Hint="{DynamicResource CustForm_LastFollowUpDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                    <DatePicker Grid.Column="2" SelectedDate="{Binding NextFollowUpDate}"
                                materialDesign:HintAssist.Hint="{DynamicResource CustForm_NextFollowUpDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                </Grid>

                <TextBox Text="{Binding CurrentObjection, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_CurrentObjection}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{DynamicResource CustForm_Notes}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True" Height="80" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ValidationError}" Foreground="#F44336"
                           Margin="0,4,0,0" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource Btn_Save}" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#FF6B00" BorderBrush="#FF6B00" Margin="0,0,8,0" Width="100" />
                <Button Content="{DynamicResource Btn_Cancel}" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
