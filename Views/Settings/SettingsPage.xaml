<UserControl x:Class="KarzounERP.Views.Settings.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FlowDirection="{DynamicResource AppFlowDirection}"
             d:DesignHeight="800" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <materialDesign:PackIcon Kind="Cog" Width="28" Height="28" Foreground="{DynamicResource AppPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Sett_Title}" FontSize="24" FontWeight="Bold" FontFamily="{DynamicResource AppHeadlineFontFamily}" Foreground="{DynamicResource BrandTextPrimary}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status message -->
            <Border Background="{DynamicResource BrandSuccessMuted}" Padding="12,8" CornerRadius="4" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandSuccess}" />
            </Border>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <!-- Language Settings (shown first for easy access) -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_LangSection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Sett_LangNote}" FontSize="11" Foreground="#888" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Sett_LangAr}"
                                     IsChecked="{Binding IsArabic}"
                                     GroupName="Language" Margin="0,0,24,0" />
                        <RadioButton Content="{DynamicResource Sett_LangTr}"
                                     IsChecked="{Binding IsTurkish}"
                                     GroupName="Language" Margin="0,0,24,0" />
                        <RadioButton Content="{DynamicResource Sett_LangEn}"
                                     IsChecked="{Binding IsEnglish}"
                                     GroupName="Language" Margin="0,0,24,0" />
                        <Button Content="{DynamicResource Sett_LangSave}"
                                Command="{Binding SaveLanguageCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AppButtonBrush}"
                                BorderBrush="{DynamicResource AppButtonBrush}"
                                Foreground="{DynamicResource AppButtonTextColorBrush}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,0,0,16" Padding="20" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings_Features}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" Foreground="{DynamicResource BrandTextPrimary}" />
                    <CheckBox Content="{DynamicResource Settings_ShowProductImageQuotation}" IsChecked="{Binding ShowProductImageInQuotation}" Margin="0,0,0,12" />
                    <CheckBox Content="{DynamicResource Settings_ShowCustomerContactPdf}" IsChecked="{Binding ShowCustomerContactInPdf}" Margin="0,0,0,12" />
                    
                    <TextBlock Text="{DynamicResource Settings_AutoBackup}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,8" Foreground="{DynamicResource BrandTextPrimary}" />
                    <CheckBox Content="{DynamicResource Settings_EnableAutoBackup}" IsChecked="{Binding AutoBackupEnabled}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" IsEnabled="{Binding AutoBackupEnabled}">
                        <TextBlock Text="{DynamicResource Settings_BackupInterval}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="AutoBackupIntervalMinutes" Text="{Binding AutoBackupIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="60" materialDesign:HintAssist.Hint="Minutes">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBackupIntervalInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="ToolTip" Value="{DynamicResource Msg_RequiredFields}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    <TextBlock Text="{Binding AutoBackupLocationText}" FontSize="11" Foreground="#888" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>


            <!-- Security Settings (Password Protection) -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_SecuritySection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Sett_SecurityNote}" FontSize="11" Foreground="#888" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" Content="{DynamicResource Sett_PasswordEnabled}" 
                                  IsChecked="{Binding PasswordEnabled}" VerticalAlignment="Center" />
                        
                        <TextBox Grid.Column="2" x:Name="PasswordInput" Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_PasswordInput}"
                                 IsEnabled="{Binding PasswordEnabled}"
                                 VerticalAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="ToolTip" Value="{DynamicResource Msg_RequiredFields}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Company Settings -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_CompanySection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="Name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_CompanyName}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNameInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="ToolTip" Value="{DynamicResource Msg_ValidationCompanyName}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="2" Text="{Binding CommercialName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_CommercialName}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LogoPath}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_LogoPath}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True" />
                            <Button Grid.Column="2" Content="{DynamicResource Btn_Browse}" Command="{Binding BrowseLogoCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Grid.Column="4" Content="{DynamicResource Btn_Clear}" Command="{Binding ClearLogoCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </Grid>
                        <TextBox Grid.Column="2" x:Name="Currency" Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_Currency}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrencyInvalid}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                            <Setter Property="ToolTip" Value="{DynamicResource Msg_RequiredFields}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding StampPath}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_StampPath}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     IsReadOnly="True" />
                            <Button Grid.Column="2" Content="{DynamicResource Btn_Browse}" Command="{Binding BrowseStampCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Grid.Column="4" Content="{DynamicResource Btn_Clear}" Command="{Binding ClearStampCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </Grid>
                        <Border Grid.Column="2" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Tax Settings -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_TaxSection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="{DynamicResource Sett_TaxEnabled}" IsChecked="{Binding TaxEnabled}" Margin="0,0,16,0" />
                        <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_TaxRate}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Width="200"
                                 IsEnabled="{Binding TaxEnabled}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- Numbering -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_NumberingSection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBox x:Name="InvoicePrefix" Text="{Binding InvoicePrefix, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_InvoicePrefix}"
                                     Margin="0,0,0,12">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInvoicePrefixInvalid}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="ToolTip" Value="{DynamicResource Msg_RequiredFields}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Text="{Binding NextInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_NextInvoiceNumber}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                            <TextBlock Foreground="#888" FontSize="11">
                                <Run Text="{DynamicResource Sett_Next}" />
                                <Run Text="{Binding NextInvoicePreview}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBox x:Name="QuotationPrefix" Text="{Binding QuotationPrefix, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_QuotationPrefix}"
                                     Margin="0,0,0,12">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuotationPrefixInvalid}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrandDanger}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="ToolTip" Value="{DynamicResource Msg_RequiredFields}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox Text="{Binding NextQuotationNumber, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{DynamicResource Sett_NextQuotationNumber}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                            <TextBlock Foreground="#888" FontSize="11">
                                <Run Text="{DynamicResource Sett_Next}" />
                                <Run Text="{Binding NextQuotationPreview}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <Separator Background="{DynamicResource BrandBorder}" Margin="0,12,0,16" />
                    
                            <TextBox Text="{Binding NumberPadding, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_NumberPadding}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Width="200" HorizontalAlignment="{DynamicResource AppContentAlignment}" Margin="0,0,0,16" />
                    
                    <TextBox Text="{Binding QrCodeTemplate, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_QrCodeTemplate}"
                             materialDesign:HintAssist.HelperText="{DynamicResource Sett_QrCodeTemplateHelp}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Default Notes -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_TextsSection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,16" />
                    <TextBox Text="{Binding DefaultInvoiceNotes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_InvoiceNotes}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                    <TextBox Text="{Binding DefaultQuotationNotes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_QuotationNotes}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                    <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_FooterText}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />
                    <TextBox Text="{Binding PaymentInfo, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{DynamicResource Sett_PaymentInfo}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Save button -->
            <Button Content="{DynamicResource Sett_SaveBtn}"
                    Command="{Binding SaveSettingsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}"
                    Width="200" HorizontalAlignment="{DynamicResource AppOppositeHorizontalAlignment}"
                    Margin="0,0,0,24" />

            <!-- Backup & Restore -->
            <materialDesign:Card Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Sett_BackupSection}" FontWeight="Bold" Foreground="{DynamicResource AppPrimaryBrush}" FontSize="14" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BackupFolder}"
                                 materialDesign:HintAssist.Hint="{DynamicResource Sett_BackupFolder}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="True" />
                        <Button Grid.Column="2" Content="{DynamicResource Btn_Browse}" Command="{Binding BrowseBackupFolderCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Sett_BackupNow}"
                                Command="{Binding BackupNowCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource BrandSuccess}" BorderBrush="{DynamicResource BrandSuccess}" Margin="0,0,12,0" />
                        <Button Content="{DynamicResource Sett_Restore}"
                                Command="{Binding RestoreBackupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{DynamicResource BrandDanger}" Foreground="{DynamicResource BrandDanger}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
