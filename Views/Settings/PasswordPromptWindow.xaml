<Window x:Class="KarzounERP.Views.Settings.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource App_PasswordRequired}"
        Height="240" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        FlowDirection="{DynamicResource AppFlowDirection}">

    <Border CornerRadius="8" Background="{DynamicResource BrandSurface}" BorderBrush="{DynamicResource AppButtonBrush}" BorderThickness="1.5">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Lock" Foreground="{DynamicResource AppPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center" Margin="{DynamicResource AppIconMargin}" />
                <TextBlock Text="{DynamicResource App_PasswordRequired}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrandTextPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Password Box -->
            <PasswordBox x:Name="TxtPassword" Grid.Row="1"
                         materialDesign:HintAssist.Hint="{DynamicResource App_EnterPassword}"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         KeyDown="TxtPassword_KeyDown" />

            <!-- Error Message -->
            <TextBlock x:Name="TxtError" Grid.Row="2"
                       Text="{DynamicResource App_InvalidPassword}"
                       Foreground="{DynamicResource BrandDanger}" FontSize="11" Margin="0,4,0,0"
                       Visibility="Collapsed" HorizontalAlignment="Center" />

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource CustDetail_Back}" Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource DocForm_Save}" Click="Ok_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Background="{DynamicResource AppButtonBrush}" BorderBrush="{DynamicResource AppButtonBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
