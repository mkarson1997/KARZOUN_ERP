    <RepositoryType>git</RepositoryType>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      DisableFastUpToDateCheck: Forces MSBuild to verify all intermediate files
      on every incremental build rather than trusting the fast up-to-date cache.
      Prevents BG1002 "missing .baml" errors caused by stale or partial obj folders
      when switching Debug/Release or after a failed build.
    -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
