  <!--
    BG1002 Permanent Fix:
    Delete the MarkupCompile cache files before every Pass1 run.
    This forces XAML recompile on every build (~2s overhead) which is far better
    than intermittent BG1002 failures caused by stale incremental BAML state.
    Root cause: Pass2 (in the wpftmp project) reads BAMLs written by Pass1.
    When the cache claims Pass1 is up-to-date but the BAMLs are actually stale
    (after Debug↔Release switch, killed process, or any interrupted build),
    Pass2 cannot find them → BG1002.
    Always running Pass1 eliminates the stale-cache scenario entirely.
  -->
  <Target Name="AlwaysRecompileXaml" BeforeTargets="MarkupCompilePass1">
    <Delete Files="$(IntermediateOutputPath)$(MSBuildProjectName)_MarkupCompile.cache;&#xA;                   $(IntermediateOutputPath)$(MSBuildProjectName)_MarkupCompile.lref" ContinueOnError="true" />
  </Target>

</Project>
