    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Updated to 2025.1.0 (the actually resolved version) to silence NU1603 -->
    <PackageReference Include="QuestPDF" Version="2025.1.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <!--
    Explicit Page metadata for every XAML file.
    Using "Update" (not "Include") so we augment the SDK's implicit glob — not replace it.
    Generator=MSBuild:Compile + SubType=Designer ensures the WPF XAML compiler
    treats each file the same way regardless of whether it was auto-detected or not,
    which prevents the MarkupCompilePass2 from skipping files on incremental rebuilds.
  -->
  <!-- Localization string ResourceDictionaries — must be Resource not Page -->
  <ItemGroup>
    <Resource Include="Resources\Brand\AppIcon.ico" />
    <Resource Include="Resources\Brand\InstallerIcon.ico" />
    <Resource Include="Resources\Brand\KARZOUN_ERP_AppIcon.png" />
